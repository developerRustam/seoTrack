# PostgreSQL: replace credentials and point to an existing database
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/seotrack
# DIRECT_URL=postgresql://postgres:replace-me@localhost:5432/seotrack

# Authentication: generate a unique value of at least 32 characters
JWT_SECRET=

# Comma-separated frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Google PageSpeed Insights
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=45000

# Server and check processing
PORT=4000
CHECK_RUN_STALE_MS=600000
NODE_ENV=development
